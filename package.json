{
  "name": "create-svc",
  "version": "0.1.11",
  "description": "Local microservice bootstrap CLI for Cloud Run and Workers services with Neon-backed data.",
  "module": "index.ts",
  "type": "module",
  "license": "MIT",
  "bin": {
    "create-service": "bin/create-service.mjs",
    "create-svc": "bin/create-svc.mjs"
  },
  "files": [
    "bin/create-service.mjs",
    "bin/create-svc.mjs",
    "index.ts",
    "src",
    "templates",
    "!bin/generated",
    "!templates/**/node_modules",
    "README.md"
  ],
  "scripts": {
    "dev": "bun run index.ts",
    "test": "bun test src scripts",
    "validate:generated": "bun run ./scripts/validate-generated.ts",
    "typecheck": "bunx tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anmho/create-svc.git"
  },
  "homepage": "https://github.com/anmho/create-svc#readme",
  "bugs": {
    "url": "https://github.com/anmho/create-svc/issues"
  },
  "keywords": [
    "bun",
    "backend",
    "cloud-run",
    "connectrpc",
    "grpc",
    "hono",
    "monorepo",
    "scaffold"
  ],
  "packageManager": "bun@1.3.2",
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@clack/prompts": "^1.4.0",
    "@google-cloud/billing": "^5.1.2",
    "@google-cloud/resource-manager": "^6.2.2",
    "@neondatabase/api-client": "^2.7.1",
    "picocolors": "^1.1.1"
  }
}
