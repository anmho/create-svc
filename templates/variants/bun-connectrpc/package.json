{
  "name": "{{SERVICE_NAME}}",
  "private": true,
  "type": "module",
  "bin": {
    "service": "./scripts/service.ts",
    "svc-cloudrun": "./scripts/cloudrun/cli.ts"
  },
  "scripts": {
    "dev": "bun run ./src/index.ts",
    "dev:down": "bun run ./scripts/service.ts dev down",
    "migrate": "bun run ./scripts/migrate.ts",
    "gen": "bun run ./scripts/codegen.ts",
    "lint": "bunx tsc --noEmit",
    "test": "bun test",
    "bootstrap": "bun run ./scripts/cloudrun/cli.ts bootstrap",
    "deploy": "bun run ./scripts/cloudrun/cli.ts deploy",
    "cleanup": "bun run ./scripts/cloudrun/cli.ts cleanup"
  },
  "dependencies": {
    "@google-cloud/storage": "^7.17.2",
    "@bufbuild/protobuf": "^2.7.0",
    "@clack/prompts": "^1.2.0",
    "@connectrpc/connect": "^2.0.2",
    "@connectrpc/connect-node": "^2.0.2",
    "drizzle-orm": "^0.44.5",
    "@neondatabase/api-client": "^2.7.1"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@bufbuild/protoc-gen-es": "^2.7.0",
    "drizzle-kit": "^0.31.4",
    "typescript": "^5.9.3"
  }
}
